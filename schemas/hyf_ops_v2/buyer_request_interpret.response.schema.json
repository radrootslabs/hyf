{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hyf_ops_v2/buyer_request_interpret.response.schema.json",
  "title": "hyf_ops_v2 buyer_request.interpret strict response (ADR-0025 D45 CB02-CB04)",
  "$comment": "Typed demand lines with the D23 reported decimal-string projection; inference is never treated as confirmation.",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "output": {
      "$ref": "#/$defs/interpret_output"
    },
    "error": {
      "$ref": "#/$defs/wire_error"
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["version", "request_id", "ok"],
  "additionalProperties": false,
  "$defs": {
    "wire_error": {
      "type": "object",
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string"}
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "evidence_span": {
      "type": "object",
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0},
        "method": {"type": "string", "minLength": 1}
      },
      "required": ["source_id", "revision", "start", "end", "method"],
      "additionalProperties": false
    },
    "reported_quantity": {
      "type": "object",
      "properties": {
        "state": {"type": "string", "enum": ["known", "unknown"]},
        "value": {
          "type": ["string", "null"],
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,9})?$"
        },
        "unit": {"type": ["string", "null"], "minLength": 1},
        "qualifier": {"type": "string", "enum": ["exact", "approximate"]}
      },
      "required": ["state", "qualifier"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"state": {"const": "unknown"}},
            "required": ["state"]
          },
          "then": {
            "properties": {"value": {"type": "null"}, "unit": {"type": "null"}}
          }
        },
        {
          "if": {
            "properties": {"state": {"const": "known"}},
            "required": ["state"]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,9})?$"
              },
              "unit": {"type": "string", "minLength": 1}
            },
            "required": ["value", "unit"]
          }
        }
      ]
    },
    "product_ref": {
      "type": "object",
      "properties": {
        "phrase": {"type": "string", "minLength": 1},
        "catalogue_id": {"type": ["string", "null"], "minLength": 1},
        "resolution": {"type": "string", "enum": ["resolved", "unresolved"]}
      },
      "required": ["phrase", "catalogue_id", "resolution"],
      "additionalProperties": false
    },
    "demand_line": {
      "type": "object",
      "properties": {
        "line_id": {"type": "string", "minLength": 1},
        "product": {"$ref": "#/$defs/product_ref"},
        "quantity": {"$ref": "#/$defs/reported_quantity"},
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "fulfillment",
                  "window",
                  "grade",
                  "price",
                  "attribute",
                  "substitution"
                ]
              },
              "strength": {
                "type": "string",
                "enum": ["mandatory", "preferred", "excluded", "permitted"]
              },
              "value": {"type": ["string", "null"]},
              "evidence": {
                "type": "array",
                "items": {"$ref": "#/$defs/evidence_span"}
              }
            },
            "required": ["kind", "strength", "evidence"],
            "additionalProperties": false
          }
        },
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence_span"}
        },
        "review_required": {"type": "boolean"}
      },
      "required": [
        "line_id",
        "product",
        "quantity",
        "conditions",
        "evidence",
        "review_required"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "required": {"type": "boolean"},
        "clarifications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            },
            "required": ["field", "reason"],
            "additionalProperties": false
          }
        }
      },
      "required": ["required", "clarifications"],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "enum": ["complete", "degraded", "failed"]},
        "provider_calls": {"type": "integer", "minimum": 0},
        "model": {"type": ["string", "null"]},
        "question_bundle": {"type": ["string", "null"]}
      },
      "required": ["status", "provider_calls", "model", "question_bundle"],
      "additionalProperties": false
    },
    "interpret_output": {
      "type": "object",
      "properties": {
        "demand_lines": {
          "type": "array",
          "items": {"$ref": "#/$defs/demand_line"}
        },
        "review": {"$ref": "#/$defs/review"},
        "execution": {"$ref": "#/$defs/execution"}
      },
      "required": ["demand_lines", "review", "execution"],
      "additionalProperties": false
    }
  }
}
