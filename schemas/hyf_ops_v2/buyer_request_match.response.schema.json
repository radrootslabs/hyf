{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hyf_ops_v2/buyer_request.match.response.schema.json",
  "title": "hyf_ops_v2 buyer_request.match strict response (ADR-0025 D45 CB02-CB04)",
  "$comment": "Assessments and bounded single-supplier plans are suggestions, never reservations. Allocated quantities use the D23 reported projection and carry the lot revision.",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "output": {
      "$ref": "#/$defs/match_output"
    },
    "error": {
      "$ref": "#/$defs/wire_error"
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["version", "request_id", "ok"],
  "additionalProperties": false,
  "$defs": {
    "wire_error": {
      "type": "object",
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string"}
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "evidence_span": {
      "type": "object",
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0},
        "method": {"type": "string", "minLength": 1}
      },
      "required": ["source_id", "revision", "start", "end", "method"],
      "additionalProperties": false
    },
    "reported_quantity": {
      "type": "object",
      "properties": {
        "state": {"type": "string", "enum": ["known", "unknown"]},
        "value": {
          "type": ["string", "null"],
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,9})?$"
        },
        "unit": {"type": ["string", "null"], "minLength": 1},
        "qualifier": {"type": "string", "enum": ["exact", "approximate"]}
      },
      "required": ["state", "qualifier"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"state": {"const": "unknown"}},
            "required": ["state"]
          },
          "then": {
            "properties": {"value": {"type": "null"}, "unit": {"type": "null"}}
          }
        },
        {
          "if": {
            "properties": {"state": {"const": "known"}},
            "required": ["state"]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,9})?$"
              },
              "unit": {"type": "string", "minLength": 1}
            },
            "required": ["value", "unit"]
          }
        }
      ]
    },
    "check": {
      "type": "object",
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "result": {"type": "string", "enum": ["pass", "fail", "unknown"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence_span"}
        }
      },
      "required": ["kind", "result", "reason"],
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "eligibility": {
          "type": "string",
          "enum": ["eligible", "conditional", "ineligible"]
        },
        "checks": {
          "type": "array",
          "items": {"$ref": "#/$defs/check"}
        }
      },
      "required": ["candidate_id", "eligibility", "checks"],
      "additionalProperties": false
    },
    "allocation": {
      "type": "object",
      "properties": {
        "lot_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "line_id": {"type": "string", "minLength": 1},
        "quantity": {"$ref": "#/$defs/reported_quantity"}
      },
      "required": ["lot_id", "revision", "line_id", "quantity"],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "plan_id": {"type": "string", "minLength": 1},
        "supplier_id": {"type": "string", "minLength": 1},
        "allocations": {
          "type": "array",
          "items": {"$ref": "#/$defs/allocation"}
        },
        "coverage": {
          "type": "object",
          "properties": {
            "lines_covered": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "uncovered": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "partial": {"type": "boolean"}
          },
          "required": ["lines_covered", "uncovered", "partial"],
          "additionalProperties": false
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            },
            "required": ["kind", "reason"],
            "additionalProperties": false
          }
        },
        "preference": {
          "type": "object",
          "properties": {
            "policy": {"type": "string", "minLength": 1},
            "score": {"type": "integer"}
          },
          "required": ["policy", "score"],
          "additionalProperties": false
        }
      },
      "required": ["plan_id", "supplier_id", "allocations", "coverage"],
      "additionalProperties": false
    },
    "limitations": {
      "type": "object",
      "properties": {
        "scope": {"type": "string", "enum": ["supplied_only"]},
        "truncated": {"type": "boolean"},
        "supported_mode": {"type": "string", "minLength": 1},
        "unsupported": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "required": ["scope", "truncated", "supported_mode", "unsupported"],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "enum": ["complete", "degraded", "failed"]},
        "provider_calls": {"type": "integer", "minimum": 0},
        "model": {"type": ["string", "null"]},
        "question_bundle": {"type": ["string", "null"]}
      },
      "required": ["status", "provider_calls", "model", "question_bundle"],
      "additionalProperties": false
    },
    "match_output": {
      "type": "object",
      "properties": {
        "assessments": {
          "type": "array",
          "items": {"$ref": "#/$defs/assessment"}
        },
        "plans": {
          "type": "array",
          "items": {"$ref": "#/$defs/plan"}
        },
        "limitations": {"$ref": "#/$defs/limitations"},
        "execution": {"$ref": "#/$defs/execution"}
      },
      "required": ["assessments", "plans", "limitations", "execution"],
      "additionalProperties": false
    }
  }
}
