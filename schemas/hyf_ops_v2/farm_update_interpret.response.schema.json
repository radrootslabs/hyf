{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hyf_ops_v2/farm_update_interpret.response.schema.json",
  "title": "hyf_ops_v2 farm_update.interpret strict response (ADR-0025 D45 CB02-CB04)",
  "$comment": "Proposals only, never inventory mutation. quantity uses the D23 reported decimal-string projection. Envelope version stays 1.",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "output": {
      "$ref": "#/$defs/farm_output"
    },
    "error": {
      "$ref": "#/$defs/wire_error"
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["version", "request_id", "ok"],
  "additionalProperties": false,
  "$defs": {
    "wire_error": {
      "type": "object",
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string"}
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "evidence_span": {
      "type": "object",
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0},
        "method": {"type": "string", "minLength": 1}
      },
      "required": ["source_id", "revision", "start", "end", "method"],
      "additionalProperties": false
    },
    "reported_quantity": {
      "type": "object",
      "properties": {
        "state": {"type": "string", "enum": ["known", "unknown"]},
        "value": {
          "type": ["string", "null"],
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,9})?$"
        },
        "unit": {"type": ["string", "null"], "minLength": 1},
        "qualifier": {"type": "string", "enum": ["exact", "approximate"]}
      },
      "required": ["state", "qualifier"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"state": {"const": "unknown"}},
            "required": ["state"]
          },
          "then": {
            "properties": {"value": {"type": "null"}, "unit": {"type": "null"}}
          }
        },
        {
          "if": {
            "properties": {"state": {"const": "known"}},
            "required": ["state"]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,9})?$"
              },
              "unit": {"type": "string", "minLength": 1}
            },
            "required": ["value", "unit"]
          }
        }
      ]
    },
    "product_ref": {
      "type": "object",
      "properties": {
        "phrase": {"type": "string", "minLength": 1},
        "catalogue_id": {"type": ["string", "null"], "minLength": 1},
        "resolution": {"type": "string", "enum": ["resolved", "unresolved"]}
      },
      "required": ["phrase", "catalogue_id", "resolution"],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "product": {"$ref": "#/$defs/product_ref"},
        "status": {
          "type": "string",
          "enum": ["offered", "forecast", "unavailable", "correction", "unclear"]
        },
        "quantity": {"$ref": "#/$defs/reported_quantity"},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence_span"}
        },
        "review_required": {"type": "boolean"}
      },
      "required": ["claim_id", "product", "status", "evidence", "review_required"],
      "additionalProperties": false
    },
    "proposed_change": {
      "type": "object",
      "properties": {
        "target": {
          "type": "object",
          "properties": {
            "kind": {"type": "string", "enum": ["listing", "product", "farm"]},
            "id": {"type": ["string", "null"], "minLength": 1}
          },
          "required": ["kind", "id"],
          "additionalProperties": false
        },
        "operation": {
          "type": "string",
          "enum": [
            "addition",
            "remaining",
            "replacement",
            "withdrawal",
            "correction",
            "unresolved"
          ]
        },
        "expected_revision": {"type": ["string", "null"], "minLength": 1},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence_span"}
        }
      },
      "required": ["target", "operation", "evidence"],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "required": {"type": "boolean"},
        "clarifications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            },
            "required": ["field", "reason"],
            "additionalProperties": false
          }
        }
      },
      "required": ["required", "clarifications"],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "enum": ["complete", "degraded", "failed"]},
        "provider_calls": {"type": "integer", "minimum": 0},
        "model": {"type": ["string", "null"]},
        "question_bundle": {"type": ["string", "null"]}
      },
      "required": ["status", "provider_calls", "model", "question_bundle"],
      "additionalProperties": false
    },
    "farm_output": {
      "type": "object",
      "properties": {
        "claims": {
          "type": "array",
          "items": {"$ref": "#/$defs/claim"}
        },
        "proposed_changes": {
          "type": "array",
          "items": {"$ref": "#/$defs/proposed_change"}
        },
        "review": {"$ref": "#/$defs/review"},
        "execution": {"$ref": "#/$defs/execution"}
      },
      "required": ["claims", "proposed_changes", "review", "execution"],
      "additionalProperties": false
    }
  }
}
